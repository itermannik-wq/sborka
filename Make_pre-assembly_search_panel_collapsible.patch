diff --git a/app/src/main/java/com/boldrex/postavki/OzonApiConfig.kt b/app/src/main/java/com/boldrex/postavki/OzonApiConfig.kt
new file mode 100644
--- /dev/null	(revision 7691907c2d3bac89e82841d4ece5ed414cd0b1a7)
+++ b/app/src/main/java/com/boldrex/postavki/OzonApiConfig.kt	(revision 7691907c2d3bac89e82841d4ece5ed414cd0b1a7)
@@ -0,0 +1,17 @@
+package com.boldrex.postavki
+
+/**
+ * Конфигурация для Ozon API.
+ *
+ * Заполните значения своими данными из кабинета Ozon Seller API.
+ */
+object OzonApiConfig {
+    // Базовый URL Ozon Seller API
+    const val BASE_URL: String = "https://api-seller.ozon.ru/"
+
+    // Client-Id из Ozon
+    const val CLIENT_ID: String = ""
+
+    // API Key из Ozon
+    const val API_KEY: String = ""
+}
